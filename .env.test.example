# Playwright E2E Test Environment Variables
# ==========================================
# Copy this file to .env.test and fill in your values
# Note: Base infrastructure config is loaded from .env automatically

# Test User Credentials
# ---------------------
# For local Docker: Use seeded test users (created via 'task e2e-seed')
# For dev environment: Use managed credentials from secrets manager

# Admin user (administrator role)
E2E_ADMIN_EMAIL=e2e-admin@test.chatwoot.local
E2E_ADMIN_PASSWORD=Password1!

# Agent user (agent role)
E2E_AGENT_EMAIL=e2e-agent@test.chatwoot.local
E2E_AGENT_PASSWORD=Password1!

# Application URL
# ---------------
# Override base URL (optional - defaults to FRONTEND_URL from .env or http://localhost:3000)
# Uncomment for local Docker testing:
BASE_URL=http://localhost:3000

# For dev environment testing, use:
# BASE_URL=https://dev.app.chatscommerce.com

# Cross-Browser Testing
# ---------------------
# By default, tests run only on Chromium for fast feedback.
# Set to 'true' to include Firefox and WebKit (Safari) in the test run.
# You can also run specific browsers with: pnpm e2e -- --project=firefox
# E2E_ALL_BROWSERS=false
